      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What did I order last time?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:4000/api/ai/ask",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ai",
            "ask"
          ]
        },
        "description": "Personal answers need the token: a guest is asked to sign in instead."
      }
    },
    {
      "name": "13 Admin dashboard figures",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 response\", () => pm.response.to.have.status(200));",
              "pm.test('the breakdown adds up to the headline', () => { const b = pm.response.json(); const sum = b.statusBreakdown.filter((r) => r.status !== 'cancelled').reduce((a, r) => a + r.revenue, 0); pm.expect(Number(sum.toFixed(2))).to.eql(b.orders.revenue); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "http://localhost:4000/api/admin/stats?days=30",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "stats"
          ],
          "query": [
            {
              "key": "days",
              "value": "30"
            }
          ]
        },
        "description": "SQL aggregates. Point out that the new order from request 05 and the booking from 09 are already counted."
      }
    },
    {
      "name": "14 A customer may not change the menu",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"403 response\", () => pm.response.to.have.status(403));",
              "pm.test('role enforced in the middleware', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
