          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 response\", () => pm.response.to.have.status(200));",
              "pm.test('it read the orders table', () => pm.expect(pm.response.json().sources).to.include('orders'));"
            ]
          }
        }
