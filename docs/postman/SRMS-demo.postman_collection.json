        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Not allowed\",\n  \"category\": \"main\",\n  \"description\": \"role check\",\n  \"price\": 1,\n  \"ingredients\": [],\n  \"allergens\": [],\n  \"dietaryTags\": [],\n  \"available\": true,\n  \"todaySpecial\": false,\n  \"emoji\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:4000/api/menu",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "menu"
          ]
        },
        "description": "The last slide: the same API answers 403 for the customer token and 201 for the admin token."
      }
