{
  "info": {
    "name": "SRMS — DEMO (Assignment 2 walkthrough)",
    "description": "The 14 requests to show on camera, in the order of the demo script. The full evidence is the other collection (83 requests).\n\nBefore recording:  cd server && npm run db:reset && npm run dev\n\nNothing to configure: baseUrl is http://localhost:4000/api, the two logins store the tokens, and the booking date is calculated by the collection script (the next day the restaurant is open, 19:00-20:30), so the demo can be recorded again without clashing with the previous take.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "a1b4c8e0-2201-4b7a-9d31-srms22010003"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// pick the next day the restaurant is open (closed Mondays) and a slot inside the opening hours",
          "const date = new Date();",
          "do { date.setDate(date.getDate() + 1); } while (date.getDay() === 1);",
          "pm.collectionVariables.set('demoDate', date.toISOString().slice(0, 10));",
          "pm.collectionVariables.set('demoStart', '19:00');",
          "pm.collectionVariables.set('demoEnd', '20:30');"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "reservationId",
      "value": ""
    },
    {
      "key": "tableId",
      "value": ""
    },
    {
      "key": "demoDate",
      "value": ""
    },
    {
      "key": "demoStart",
      "value": "19:00"
    },
    {
      "key": "demoEnd",
      "value": "20:30"
    }
  ],
  "item": [
    {
      "name": "01 Health and database",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 response\", () => pm.response.to.have.status(200));",
              "pm.test('MySQL is connected', () => pm.expect(pm.response.json().database).to.include('connected'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:4000/api/health/db",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health",
            "db"
          ]
        },
        "description": "Proves the API is up and MySQL is connected before anything else is shown."
      }
    },
    {
      "name": "02 Log in as the customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 response\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('customerToken', pm.response.json().token);",
              "pm.test('no password in the response', () => pm.expect(pm.response.json().user).to.not.have.property('password'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@srms.dev\",\n  \"password\": \"demo1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:4000/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "bcrypt check + a JWT. Say: the password hash never travels back to the client."
      }
    },
    {
      "name": "03 Log in as the admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 response\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().token);",
              "pm.test('the role is admin', () => pm.expect(pm.response.json().user.role).to.eql('admin'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@srms.dev\",\n  \"password\": \"demo1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:4000/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Same endpoint, different role — the role lives in the token."
      }
    },
    {
      "name": "04 Browse the menu with filters",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 response\", () => pm.response.to.have.status(200));",
              "pm.test('every dish matches the filter', () => pm.response.json().items.forEach((i) => pm.expect(i.dietaryTags).to.include('vegetarian')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:4000/api/menu?category=main&dietary=vegetarian&sort=price",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "menu"
          ],
          "query": [
            {
              "key": "category",
              "value": "main"
            },
            {
              "key": "dietary",
              "value": "vegetarian"
            },
            {
              "key": "sort",
              "value": "price"
            }
          ]
        },
        "description": "The filters run in SQL (JSON_CONTAINS on dietary_tags), not in JavaScript after the query."
      }
    },
    {
      "name": "05 Place an order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 response\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('orderId', pm.response.json().order.id);",
              "pm.test('the server did the money', () => { const o = pm.response.json().order; pm.expect(Number((o.subtotal + o.deliveryFee + o.tax).toFixed(2))).to.eql(o.total); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fulfilment\": \"delivery\",\n  \"deliveryAddress\": \"5 Example Street, London SE1 4PG\",\n  \"items\": [\n    {\n      \"menuItemId\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"menuItemId\": 11,\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:4000/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "description": "The client sends only dish ids and quantities; the server looks up the prices and adds tax and delivery."
      }
    },
    {
      "name": "06 Try to set your own total",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"422 response\", () => pm.response.to.have.status(422));",
              "pm.test('refused with a code', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_FAILED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fulfilment\": \"pickup\",\n  \"total\": 0.01,\n  \"items\": [\n    {\n      \"menuItemId\": 1,\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:4000/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "description": "The devtools attack: an unknown field is refused because the schemas are strict."
      }
    },
    {
      "name": "07 Skip a step in the kitchen",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"409 response\", () => pm.response.to.have.status(409));",
              "pm.test('the workflow is enforced', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_STATUS_TRANSITION'));",
              "pm.test('the allowed steps come back', () => pm.expect(pm.response.json().error.details.allowed).to.eql(['preparing', 'cancelled']));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"delivered\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:4000/api/orders/{{orderId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{orderId}}",
            "status"
          ]
        },
        "description": "pending goes to preparing, not straight to delivered — and the response says what is allowed next."
      }
    },
    {
      "name": "08 Find a free table",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 response\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tableId', pm.response.json().tables[0].id);",
              "pm.test('free tables are returned', () => pm.expect(pm.response.json().tables).to.be.an('array').that.isNotEmpty());"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:4000/api/reservations/availability?date=%7B%7BdemoDate%7D%7D&startTime=%7B%7BdemoStart%7D%7D&endTime=%7B%7BdemoEnd%7D%7D&partySize=4",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservations",
            "availability"
          ],
          "query": [
            {
              "key": "date",
              "value": "{{demoDate}}"
            },
            {
              "key": "startTime",
              "value": "{{demoStart}}"
            },
            {
              "key": "endTime",
              "value": "{{demoEnd}}"
            },
            {
              "key": "partySize",
              "value": "4"
            }
          ]
        },
        "description": "Tables that seat the party and have no overlapping booking, for the calculated date. The first one is captured as {{tableId}}."
      }
    },
    {
      "name": "09 Book it",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 response\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('reservationId', pm.response.json().reservation.id);",
              "pm.test('a table was assigned', () => pm.expect(pm.response.json().reservation.table).to.exist);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"{{demoDate}}\",\n  \"startTime\": \"{{demoStart}}\",\n  \"endTime\": \"{{demoEnd}}\",\n  \"partySize\": 4,\n  \"type\": \"standard\",\n  \"tableId\": \"{{tableId}}\",\n  \"contact\": {\n    \"name\": \"Demo Guest\",\n    \"email\": \"demo@srms.dev\",\n    \"phone\": \"+44 20 7946 0111\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:4000/api/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservations"
          ]
        },
        "description": "The table from request 08 is booked inside a transaction. Re-recordable: each take picks the next free table."
      }
    },
    {
      "name": "10 Book the same table again",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"409 response\", () => pm.response.to.have.status(409));",
              "pm.test('the clash names the booking', () => pm.expect(pm.response.json().error.details.conflictReference).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"{{demoDate}}\",\n  \"startTime\": \"{{demoStart}}\",\n  \"endTime\": \"{{demoEnd}}\",\n  \"partySize\": 4,\n  \"tableId\": \"{{tableId}}\",\n  \"contact\": {\n    \"name\": \"Greedy Greg\",\n    \"email\": \"greg@example.com\",\n    \"phone\": \"+44 20 7946 0112\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:4000/api/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservations"
          ]
        },
        "description": "The double-booking guard: SELECT ... FOR UPDATE in reservationService.js."
      }
    },
    {
      "name": "11 Ask the AI assistant",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 response\", () => pm.response.to.have.status(200));",
              "pm.test('the answer is backed by orders', () => pm.expect(pm.response.json().sources).to.include('order_items'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What do you recommend?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:4000/api/ai/ask",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ai",
            "ask"
          ]
        },
        "description": "The answer is built by ordering real order_items rows, so it changes with the data."
      }
    },
