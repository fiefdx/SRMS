NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Session/token security
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Data store (see docs/ASSIGNMENT2.md)
DB_CLIENT=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/srms
MYSQL_URI=mysql://root@localhost:3306/srms

RESTAURANT_NAME=Bella Vista
MAX_PARTY_SIZE=12
