NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Session/token security
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# MySQL (Assignment 2 data store)
MYSQL_URI=mysql://root@127.0.0.1:3306/srms
MYSQL_TEST_URI=mysql://root@127.0.0.1:3306/srms_test
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=4000

RESTAURANT_NAME=Bella Vista
MAX_PARTY_SIZE=12

# Optional external AI provider (assistant feedback brief). Leave the key empty to use the local,
# explainable classifier — the API works either way.
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
